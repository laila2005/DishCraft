{
  "name": "dishcraft-fullstack",
  "version": "1.0.0",
  "description": "DishCraft - Full Stack Recipe Application",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.4",
    "resend": "^4.6.0",
    "mongodb": "^6.17.0",
    "react-quill": "^2.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [
    "recipe",
    "meal-planner",
    "node.js",
    "express",
    "mongodb",
    "react",
    "vercel"
  ],
  "author": "laila mohamed",
  "license": "ISC"
}
